// Prisma schema for the Jobber home-services marketplace
// Run: npx prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Every account can both post missions and apply to them — MANAGER/JOBBER
// are no longer exclusive gates, just the default label shown at signup.
enum Role {
  MANAGER
  JOBBER
  ADMIN
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  APPROVED
  REJECTED
}

enum MissionStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// PUBLIC missions show on Jobber's public marketplace as usual. PRIVATE
// missions never appear there — used for corporate demandes still pending
// agency review, missions the agency handles itself ("Mission Agence"),
// and direct employee-targeted offers ("Embaucher pour une mission").
// A PRIVATE mission becomes PUBLIC only when the agency clicks "Publier
// sur Jobber".
enum MissionVisibility {
  PUBLIC
  PRIVATE
}

enum OfferStatus {
  PENDING
  // Auto-picked by the "5 offers or 11h" rule as the best jobber offer on a
  // mission an agency published — sits here while the agency builds its
  // client devis (see Offer.sourceOfferId), before the client ever sees it.
  SELECTED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum BookingStatus {
  SCHEDULED
  IN_PROGRESS
  // Jobber has marked the work done — awaiting the client's validation
  // before it flips to COMPLETED (see PATCH /bookings/:id/mark-done).
  AWAITING_VALIDATION
  COMPLETED
  CANCELLED
  DISPUTED
}

enum PaymentStatus {
  REQUIRES_PAYMENT
  HELD_IN_ESCROW
  RELEASED
  REFUNDED
  FAILED
}

enum DocumentType {
  ID_CARD
  PROOF_OF_ADDRESS
  BANK_ACCOUNT
  DIPLOMA
}

enum PayoutStatus {
  PENDING
  COMPLETED
  FAILED
}

enum SkillLevel {
  PROFESSIONNEL
  EXPERT
  PASSIONNE
}

enum SubscriptionPlan {
  MANAGER_BOSS
  MANAGER_HOLDER
  ENTERPRISE_20
  ENTERPRISE_50
  ENTERPRISE_UNLIMITED
  JOBBER_SILVER
  JOBBER_GOLD
  JOBBER_PLATINUM
}

// An individual account can be both a manager (posting missions) and a
// jobber (applying to them) at once, so it may hold one active MANAGER-side
// subscription (waives the poster's fee) AND one active JOBBER-side
// subscription (waives the provider's fee) simultaneously — family is what
// the @@unique([userId, family]) below is keyed on.
enum SubscriptionFamily {
  MANAGER
  JOBBER
}

// Every account is INDIVIDUAL by default (can both post missions and
// candidater — see the User model). COMPANY accounts ("Recrutez vos
// collaborateurs à la tâche") can only post/manage missions, never apply
// to them — no providerProfile is created for them at signup.
enum AccountKind {
  INDIVIDUAL
  COMPANY
}

// ENTREPRISE: recruits directly for its own operational needs (packing,
// unloading trucks, site cleanup…). CORPORATE: a home-services company
// subcontracting its own client-facing service delivery to Jobber. Purely
// a self-declared badge — both have identical permissions/fees.
enum CompanyType {
  ENTREPRISE
  CORPORATE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}

enum VehicleType {
  VOITURE_TOURISME
  MINIBUS
  CAMION_BENNE
  REMORQUE
  GRANDE_REMORQUE
  PETIT_UTILITAIRE_4M3
  FOURGONNETTE_9M3
  CAMION_15M3
  GRAND_CAMION_20M3
  POIDS_LOURD
  CAMION_PLATEAU
  REMORQUE_BATEAU
}

enum RecurrenceUnit {
  JOUR
  SEMAINE
  MOIS
  AN
}

enum MissionType {
  TASK
  LESSON
}

model User {
  id                String     @id @default(cuid())
  email             String     @unique
  passwordHash      String?
  firstName         String
  lastName          String
  phone             String?
  role              Role       @default(MANAGER)
  accountKind       AccountKind @default(INDIVIDUAL)
  companyType       CompanyType?
  companyName       String?
  companySiret      String?    @unique
  // Self-declared professional status (auto-entrepreneur/EI), asked once at
  // signup — distinct from the per-category "Professionnel" skill level set
  // later in the provider profile. Drives the "PRO" badge on public profiles.
  isProfessional    Boolean    @default(false)
  professionalSiret String?    @unique
  avatarUrl         String?
  address           String?
  lat               Float?
  lng               Float?
  isEmailVerified   Boolean    @default(false)
  resetToken           String?   @unique
  resetTokenExpiresAt  DateTime?
  googleId             String?   @unique
  stripeCustomerId     String?   @unique
  creditBalance        Float     @default(0)
  referralCode         String?   @unique
  referredById         String?
  referredBy           User?     @relation("Referrals", fields: [referredById], references: [id])
  referrals            User[]    @relation("Referrals")
  referralEarned       Float     @default(0)
  notifyPushNews          Boolean @default(true)
  notifyEmailNews         Boolean @default(true)
  notifyEmailPartners     Boolean @default(true)
  notifySmsOffers         Boolean @default(false)
  notifySmsCancellation   Boolean @default(true)
  // Corporate agency admin login (e.g. Services 34) — a second, separate
  // credential pair (identifiant + PIN) used only for admin.<site> access,
  // independent of the account's normal email/password. Null for every
  // account that isn't a corporate agency admin.
  adminLoginId            String?   @unique
  adminPinHash            String?
  adminPinFailedAttempts  Int       @default(0)
  adminPinLockedUntil     DateTime?
  // Corporate agency's own service radius ("ma zone d'intervention"),
  // extensible up to 150 km — distinct from a jobber's ProviderProfile.radiusKm.
  serviceRadiusKm         Int?      @default(50)
  // Hostname of this agency's white-label site (e.g. "services34.fr").
  // Missions created via requests whose Origin matches this domain are
  // attributed to this agency server-side — never trusted from the client,
  // so one white-label site can never spoof another's missions. Scales to
  // any number of future corporate sites without touching client code.
  agencyDomain            String?   @unique
  // "Information entreprise" block in Paramètres — legal/company details
  // shown on the agency's own account, separate from companySiret/companyName
  // above (kept for the pre-existing entreprise/manager account flow).
  siegeSocialAddress      String?
  siegeSocialCity         String?
  siegeSocialDepartement  String?
  representantCivilite    String?
  representantNom         String?
  representantPrenom      String?
  jobberLicenseNumber     String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  providerProfile   ProviderProfile?
  subscriptions     Subscription[]
  missions          Mission[]        @relation("ClientMissions")
  offers            Offer[]          @relation("ProviderOffers")
  bookingsAsClient  Booking[]        @relation("ClientBookings")
  bookingsAsProvider Booking[]       @relation("ProviderBookings")
  sentMessages      Message[]        @relation("SentMessages")
  reviewsWritten    Review[]         @relation("ReviewAuthor")
  reviewsReceived   Review[]         @relation("ReviewTarget")
  documents         VerificationDocument[]
  conversationsAsClient   Conversation[] @relation("ConvClient")
  conversationsAsProvider Conversation[] @relation("ConvProvider")
  favoritesAsManager  Favorite[] @relation("FavoritesByManager")
  favoritedAsProvider Favorite[] @relation("FavoritedProvider")
  agencyMissions      Mission[]  @relation("CorporateAgencyMissions")
  agencyEmployees     AgencyEmployee[] @relation("AgencyEmployer")
  employedByAgencies  AgencyEmployee[] @relation("AgencyEmployeeOf")
  agencyInvoices      Invoice[]  @relation("AgencyInvoices")
  agencyPlannings     Planning[] @relation("AgencyPlannings")
  contactMessagesSent    ContactMessage[] @relation("ContactMessageSender")
  contactMessagesToAgency ContactMessage[] @relation("ContactMessageAgency")
}

// A manager bookmarking a jobber they'd like to work with again ("Mes
// jobbers favoris") — independent of whether a booking ever happened, so
// it also works for providers found via /providers browsing.
model Favorite {
  id         String   @id @default(cuid())
  managerId  String
  manager    User     @relation("FavoritesByManager", fields: [managerId], references: [id])
  providerId String
  provider   User     @relation("FavoritedProvider", fields: [providerId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([managerId, providerId])
}

// "Plus aucun frais" for the manager (MANAGER_BOSS/HOLDER, ENTERPRISE_*)
// waives the poster-side booking fee up to the plan's monthly mission
// quota; the JOBBER_* family does the same for the provider-side fee. One
// user can hold at most one ACTIVE subscription per family at a time (see
// @@unique below) — see offers.routes.js acceptOffer for where this is spent.
model Subscription {
  id                   String             @id @default(cuid())
  userId               String
  user                 User               @relation(fields: [userId], references: [id])
  family               SubscriptionFamily @default(MANAGER)
  plan                 SubscriptionPlan
  status               SubscriptionStatus @default(ACTIVE)
  stripeSubscriptionId String?            @unique
  currentPeriodStart   DateTime           @default(now())
  currentPeriodEnd     DateTime
  missionsUsedInPeriod Int                @default(0)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@unique([userId, family])
}

model ProviderProfile {
  id                  String              @id @default(cuid())
  userId              String              @unique
  user                User                @relation(fields: [userId], references: [id])
  radiusKm            Int                 @default(15)
  verificationStatus  VerificationStatus  @default(UNVERIFIED)
  ratingAverage       Float               @default(0)
  ratingCount         Int                 @default(0)
  completedMissions   Int                 @default(0)
  walletBalance       Float               @default(0)
  autoApply           Boolean             @default(false)
  offersLessons       Boolean             @default(false)
  stripeAccountId     String?             @unique
  payoutsEnabled      Boolean             @default(false)
  bankLast4           String?
  bankHolderName      String?
  autoPayout          Boolean             @default(false)
  siret               String?             @unique
  categories          ProviderCategory[]
  services            ProviderService[]
  equipment           ProviderEquipment[]
  vehicles            ProviderVehicle[]
  payouts             Payout[]
  createdAt           DateTime            @default(now())
}

// A jobber's request to move their wallet balance to their bank account.
// Money moves via Stripe Connect (Custom account) behind the scenes, but the
// jobber never sees a Stripe-branded page — everything is collected and
// triggered from our own UI.
model Payout {
  id               String       @id @default(cuid())
  providerId       String
  provider         ProviderProfile @relation(fields: [providerId], references: [id])
  amount           Float
  status           PayoutStatus @default(PENDING)
  stripeTransferId String?
  stripePayoutId   String?      @unique
  failureReason    String?
  createdAt        DateTime     @default(now())
  completedAt      DateTime?
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  icon        String?
  services    Service[]
  equipment   Equipment[]
  missions    Mission[]
  providers   ProviderCategory[]
  plannings   Planning[]
}

// An agency's own work calendar — missions "mises au planning" land here so
// the agency can track who's doing what. Defaults to one per category
// ("Planning Bricolage", "Planning Jardinage"...) but the agency can create
// as many named plannings as it likes (e.g. "Planning Emily" for a specific
// employee), optionally still scoped to a category.
model Planning {
  id         String    @id @default(cuid())
  agencyId   String
  agency     User      @relation("AgencyPlannings", fields: [agencyId], references: [id])
  name       String
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  createdAt  DateTime  @default(now())

  missions   Mission[]

  @@unique([agencyId, name])
}

// A piece of equipment/tooling typically needed for a category — the jobber
// checks off which of these they personally own ("Matériel que je possède").
model Equipment {
  id          String   @id @default(cuid())
  name        String
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  providers   ProviderEquipment[]
  missions    MissionEquipment[]

  @@unique([categoryId, name])
}

model Service {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  missions    Mission[]
  providers   ProviderService[]
  // Extra structured fields to collect at mission-publishing time for this
  // service, e.g. [{ key: 'surfaceM2', label: 'Surface', type: 'number',
  // unit: 'm²' }] — rendered dynamically, answers stored on Mission.details.
  detailFields Json?
}

// One row per main category a jobber has picked, carrying their declared
// skill level for that whole category (sub-service picks live separately
// in ProviderService).
model ProviderCategory {
  id         String     @id @default(cuid())
  providerId String
  provider   ProviderProfile @relation(fields: [providerId], references: [id])
  categoryId String
  category   Category   @relation(fields: [categoryId], references: [id])
  level      SkillLevel @default(PASSIONNE)
  hourlyRate Float      @default(15)
  bio        String?

  @@unique([providerId, categoryId])
}

// Sub-category (Service) skills a jobber has checked off within a category.
model ProviderService {
  id         String   @id @default(cuid())
  providerId String
  provider   ProviderProfile @relation(fields: [providerId], references: [id])
  serviceId  String
  service    Service  @relation(fields: [serviceId], references: [id])

  @@unique([providerId, serviceId])
}

// Equipment a jobber has checked off as owned within a category
// ("Matériel que je possède").
model ProviderEquipment {
  id          String    @id @default(cuid())
  providerId  String
  provider    ProviderProfile @relation(fields: [providerId], references: [id])
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id])

  @@unique([providerId, equipmentId])
}

// A vehicle type the jobber has access to for missions requiring transport
// ("Mes véhicules") — a fixed global list, not tied to a skill category.
model ProviderVehicle {
  id         String      @id @default(cuid())
  providerId String
  provider   ProviderProfile @relation(fields: [providerId], references: [id])
  type       VehicleType

  @@unique([providerId, type])
}

model Mission {
  id             String        @id @default(cuid())
  type           MissionType   @default(TASK)
  clientId       String
  client         User          @relation("ClientMissions", fields: [clientId], references: [id])
  categoryId     String
  category       Category      @relation(fields: [categoryId], references: [id])
  serviceId      String?
  service        Service?      @relation(fields: [serviceId], references: [id])
  title          String
  description    String
  address        String
  lat            Float?
  lng            Float?
  // Only set for transport-type missions (déménagement, convoi, transport):
  // `address`/`lat`/`lng` above act as the departure point, and these
  // describe the arrival point so a route can be drawn between the two.
  dropoffAddress String?
  dropoffLat     Float?
  dropoffLng     Float?
  photos         String[]      @default([])
  desiredDate    DateTime
  estimatedHours Float         @default(1)
  isUrgent       Boolean       @default(false)
  datesFlexible  Boolean       @default(false)
  // Asked only when the selected équipement requis includes Échelle or
  // Escabeau (bricolage/jardinage) — flags a job that involves working at
  // height so the assigned jobber knows to expect it. Null when not asked.
  workAtHeight   Boolean?
  isRecurring     Boolean         @default(false)
  recurrenceCount Int?
  recurrenceUnit  RecurrenceUnit?
  requiredVehicleTypes VehicleType[] @default([])
  otherVehicleNote     String?
  otherEquipmentNote   String?
  // Company-only options (silently ignored server-side for individual
  // accounts). Multi-day: desiredDate is the start, missionEndDate the end.
  missionEndDate             DateTime?
  equipmentProvidedByCompany Boolean?
  ppeProvidedByCompany       Boolean?
  requiredPpe                String[]  @default([])
  requiresMachine            Boolean?
  requiredMachines           String[]  @default([])
  // "GET Mission": the company fixes the mission's total price up front —
  // non-negotiable, no offers/candidature. The first jobber to GET it is
  // assigned immediately (see POST /api/missions/:id/get).
  isGetMission               Boolean   @default(false)
  getMissionPrice            Float?
  // Answers to the selected service's detailFields (e.g. { hedgeHeightM: 1.5,
  // hedgeLengthM: 12 }) — keyed by field key, shape defined per-service.
  details        Json?
  status         MissionStatus @default(OPEN)
  // Set when this mission originated from a corporate white-label site
  // (e.g. services34.fr) rather than jobber.city directly. Null for
  // ordinary missions.
  corporateAgencyId String?
  corporateAgency   User?             @relation("CorporateAgencyMissions", fields: [corporateAgencyId], references: [id])
  // "XX-AAAA-MM-123XX" — 2-letter category code, year, month, 3 random
  // digits + 2 random letters. Generated once, on creation, only for
  // corporate-agency missions.
  corporateCode     String?           @unique
  visibility        MissionVisibility @default(PUBLIC)
  // "Mise au planning" — an agency assigns an in-progress mission to one of
  // its Plannings (per-category by default, or a named one like "Planning
  // Emily") to track who's doing what. Null until assigned.
  planningId     String?
  planning       Planning?     @relation(fields: [planningId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  offers            Offer[]
  booking           Booking?
  conversations     Conversation[]
  requiredEquipment MissionEquipment[]
  scheduleEntries   MissionScheduleEntry[]
}

// One row per date in a mission's explicit schedule — used both for a
// recurring mission's "+ Ajouter une date" list (any mission, Jobber or
// agency) and for an agency's "embauche" of an employee jobber across
// several days for the same mission.
model MissionScheduleEntry {
  id        String   @id @default(cuid())
  missionId String
  mission   Mission  @relation(fields: [missionId], references: [id])
  date      DateTime
  startTime String
  hours     Float
  endTime   String
  createdAt DateTime @default(now())
}

// A jobber a corporate agency has chosen to keep in its trusted roster
// after a completed mission ("voulez-vous garder ce jobber parmi vos
// employés ?"). Powers "Mes employés" and the direct "Embaucher pour une
// mission" flow (private mission + targeted offer, no public listing).
model AgencyEmployee {
  id        String   @id @default(cuid())
  agencyId  String
  agency    User     @relation("AgencyEmployer", fields: [agencyId], references: [id])
  jobberId  String
  jobber    User     @relation("AgencyEmployeeOf", fields: [jobberId], references: [id])
  addedAt   DateTime @default(now())

  @@unique([agencyId, jobberId])
}

enum InvoiceKind {
  JOBBER_MISSION
  JOBBER_MONTHLY
  AGENCY_MISSION
  AGENCY_MONTHLY
}

// "Mes factures Jobber" / "Mes factures Agence" — one row per mission and
// one row per month, per the agency's own numbering scheme. Presentation
// (PDF layout, branding) is deliberately out of scope for now; this only
// tracks the records themselves.
model Invoice {
  id          String      @id @default(cuid())
  agencyId    String
  agency      User        @relation("AgencyInvoices", fields: [agencyId], references: [id])
  kind        InvoiceKind
  reference   String      @unique
  missionId   String?
  periodYear  Int?
  periodMonth Int?
  amount      Float
  createdAt   DateTime    @default(now())
}

// Equipment the client is asking the jobber to bring for this specific
// mission — distinct from ProviderEquipment (what a jobber owns overall).
model MissionEquipment {
  id          String    @id @default(cuid())
  missionId   String
  mission     Mission   @relation(fields: [missionId], references: [id])
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id])

  @@unique([missionId, equipmentId])
}

model Offer {
  id          String      @id @default(cuid())
  missionId   String
  mission     Mission     @relation(fields: [missionId], references: [id])
  providerId  String
  provider    User        @relation("ProviderOffers", fields: [providerId], references: [id])
  hourlyRate  Float
  extraFees   Json?       // [{ key: 'displacement', label: 'Frais de route - Déplacement', amount: 15 }, ...] — optional paid options the jobber adds to their offer, see EXTRA_FEE_TYPES in offers.routes.js
  // Only set on "Mission Agence" offers, where the agency may revise the
  // client's originally requested hours upward (never downward) when
  // pricing the quote. Null means "use mission.estimatedHours", which is
  // always the case for normal marketplace offers.
  hours       Float?
  message     String?
  status      OfferStatus @default(PENDING)
  refusalReason String?
  // Set only when the jobber declined the client's originally requested
  // date/time on a datesFlexible mission — up to 2 alternative slots
  // ([{ date: 'YYYY-MM-DD', startTime: 'HH:MM' }, ...]) the client then
  // picks from when accepting (see chosenSlot below and POST /:id/accept).
  proposedSlots Json?
  chosenSlot    Json?
  // Set only on an agency's client-facing devis offer built from a
  // SELECTED jobber offer (services34↔jobber margin workflow) — points at
  // that original jobber offer so "Commander la mission" (once the client
  // accepts this devis) knows which jobber to actually book.
  sourceOfferId String?
  sourceOffer   Offer?      @relation("OfferSource", fields: [sourceOfferId], references: [id])
  derivedOffers Offer[]     @relation("OfferSource")
  createdAt   DateTime    @default(now())

  @@unique([missionId, providerId])
}

model Booking {
  id             String        @id @default(cuid())
  missionId      String        @unique
  mission        Mission       @relation(fields: [missionId], references: [id])
  offerId        String        @unique
  clientId       String
  client         User          @relation("ClientBookings", fields: [clientId], references: [id])
  providerId     String
  provider       User          @relation("ProviderBookings", fields: [providerId], references: [id])
  scheduledDate  DateTime
  hours          Float
  hourlyRate     Float
  totalAmount    Float
  status         BookingStatus @default(SCHEDULED)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  payment        Payment?
  review         Review?
}

model Payment {
  id                    String        @id @default(cuid())
  bookingId             String        @unique
  booking               Booking       @relation(fields: [bookingId], references: [id])
  stripePaymentIntentId String?
  amount                Float
  platformFee           Float
  managerFee            Float         @default(2)
  providerFee           Float         @default(2)
  feeWaived             Boolean       @default(false)
  providerPayout        Float
  status                PaymentStatus @default(REQUIRES_PAYMENT)
  paidAt                DateTime?
  releasedAt            DateTime?
  createdAt             DateTime      @default(now())
}

model Conversation {
  id          String     @id @default(cuid())
  missionId   String
  mission     Mission    @relation(fields: [missionId], references: [id])
  clientId    String
  client      User       @relation("ConvClient", fields: [clientId], references: [id])
  providerId  String
  provider    User       @relation("ConvProvider", fields: [providerId], references: [id])
  messages    Message[]
  createdAt   DateTime   @default(now())

  @@unique([missionId, providerId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String
  sender         User         @relation("SentMessages", fields: [senderId], references: [id])
  content        String
  readAt         DateTime?
  createdAt      DateTime     @default(now())
}

enum ContactMessageStatus {
  NEW
  READ
  REPLIED
}

// A visitor's "Nous contacter" form submission — deliberately separate from
// Conversation/Message (which always require a real Mission and a specific
// client/provider pair). `agencyId` is null for a message addressed to the
// Jobber platform itself, or set when the form was submitted from a
// corporate agency's own white-label site (resolved server-side from the
// request's Origin, same mechanism as Mission.corporateAgencyId) — this is
// what routes it into that agency's own back-office inbox instead of
// Jobber's. `senderId` is set only if the visitor was logged in.
model ContactMessage {
  id        String               @id @default(cuid())
  agencyId  String?
  agency    User?                @relation("ContactMessageAgency", fields: [agencyId], references: [id])
  senderId  String?
  sender    User?                @relation("ContactMessageSender", fields: [senderId], references: [id])
  name      String
  email     String
  subject   String?
  message   String
  status    ContactMessageStatus @default(NEW)
  createdAt DateTime             @default(now())
}

// Tracks when an admin (Jobber back-office) or an agency (Services34-style
// white-label back-office) last looked at a given nav section — powers the
// red notification badges (see notificationCounts.js): a section's count is
// how many of its rows were created/updated since lastViewedAt. ownerType
// distinguishes the two back-offices sharing this table ('JOBBER_ADMIN' vs
// 'AGENCY'); ownerId is the User.id in both cases (an agency is a User row).
model AdminSectionView {
  id           String   @id @default(cuid())
  ownerType    String
  ownerId      String
  section      String
  lastViewedAt DateTime @default(now())

  @@unique([ownerType, ownerId, section])
}

model Review {
  id         String   @id @default(cuid())
  bookingId  String   @unique
  booking    Booking  @relation(fields: [bookingId], references: [id])
  authorId   String
  author     User     @relation("ReviewAuthor", fields: [authorId], references: [id])
  targetId   String
  target     User     @relation("ReviewTarget", fields: [targetId], references: [id])
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
}

model VerificationDocument {
  id         String              @id @default(cuid())
  userId     String
  user       User                @relation(fields: [userId], references: [id])
  type       DocumentType
  fileUrl    String
  status     VerificationStatus  @default(PENDING)
  reviewedAt DateTime?
  createdAt  DateTime            @default(now())
}
